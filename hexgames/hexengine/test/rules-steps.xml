<!-- A synthetic rules document for SequenceTest: a turn of two player turns, the first with two
     phases, steps at every level, a verb filter and a turn filter. -->
<game id="synthetic-steps" title="Synthetic steps" players="2">
  <sides>
    <side id="a" name="A" control="human"/>
    <side id="b" name="B" control="human"/>
  </sides>
  <map>
    <hex-ids pattern="[A-Z]" example="A"/>
    <hex-terrain id="clear" name="Clear" move-cost="1"/>
  </map>
  <counters>
    <unit-type id="infantry" name="Infantry" kind="ground"/>
  </counters>
  <sequence>
    <phase id="turn" name="Turn">
      <step id="turn-enter" does="mark" at="enter"/>
      <step id="turn-before-move" does="gate" at="before-command" commands="move" rules="gate-rule"/>
      <step id="turn-after" does="mark" at="after-command"/>
      <step id="turn-end" does="mark" at="end"/>
      <phase id="a-turn" name="A player turn" side="a">
        <step id="a-enter" does="mark" at="enter"/>
        <step id="a-end" does="mark" at="end"/>
        <phase id="a-move" name="A move">
          <step id="a-move-enter-1" does="mark" at="enter"/>
          <step id="a-move-enter-2" does="mark" at="enter" turns="2"/>
          <step id="a-move-before" does="gate" at="before-command" commands="move attack"/>
          <step id="a-move-end" does="mark" at="end"/>
        </phase>
        <phase id="a-fight" name="A fight">
          <step id="a-fight-enter" does="mark" at="enter"/>
          <step id="a-fight-before-attack" does="gate" at="before-command" commands="attack"/>
        </phase>
      </phase>
      <phase id="b-turn" name="B player turn" side="b">
        <step id="b-enter" does="mark" at="enter"/>
        <phase id="b-move" name="B move">
          <step id="b-move-end" does="mark" at="end"/>
        </phase>
      </phase>
    </phase>
  </sequence>
  <stacking enforced="always" repair="none"/>
  <zoc id="zoc" name="ZOC" range="1"/>
  <movement budget="hexes">
    <mode id="normal" name="Normal"/>
  </movement>
  <supply>
    <trace id="supply" name="Supply" sources="a" max-length="8" blocked-by-zoc="true" fatal="true" checked="always"/>
  </supply>
  <combat mandatory="true">
    <resolver id="crt" name="CRT" kind="odds-table"/>
  </combat>
  <randomizer id="die" name="Die" kind="die" size="6"/>
  <victory>
    <condition id="win" side="a" kind="immediate"/>
  </victory>
  <rule id="gate-rule" topic="sequence">Moves are gated.</rule>
</game>
