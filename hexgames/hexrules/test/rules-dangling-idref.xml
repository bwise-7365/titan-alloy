<?xml version="1.0" encoding="UTF-8"?>
<game id="synthetic" title="Synthetic" players="2">
  <sides>
    <side id="a" name="A" control="human"/>
  </sides>
  <map>
    <hex-ids pattern="[A-Z]" example="A"/>
    <hex-terrain id="clear" name="Clear" move-cost="1" stop-except="no-such-unit-type"/>
  </map>
  <counters>
    <unit-type id="infantry" name="Infantry" kind="ground"/>
  </counters>
  <sequence>
    <phase id="turn" name="Turn"/>
  </sequence>
  <stacking enforced="always" repair="none"/>
  <zoc id="zoc" name="ZOC" range="1"/>
