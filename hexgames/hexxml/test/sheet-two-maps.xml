<?xml version="1.0" encoding="UTF-8"?>
<!-- Two maps on one lattice, for the tests of multi-grid sheets: Dai Senso's West and East Maps as the
     sheet was first transcribed, cut down to three columns each. dai-senso.xml itself is one grid now. -->
<sheet xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../map_graphics/xml/hexsheet.xsd"
       id="two-maps" title="Two maps" width="500" height="260" background="paper" urban="symbol" junctions="implicit">
  <grid id="west" orientation="pointy" offset="odd" cols="3" rows="4" size="40.95" ox="62.54" oy="-8.05"
        id-format="w{row:02}{col:02}" col-start="1" row-start="61" row-step="-1" terrain="sea" id-side="w"/>
  <grid id="east" orientation="pointy" offset="odd" cols="3" rows="4" size="40.95" ox="275.32" oy="-8.05"
        id-format="e{row:02}{col:02}" col-start="1" row-start="61" row-step="-1" terrain="sea" id-side="w"/>
  <palette>
    <color id="paper" value="#f3efe2"/>
    <color id="seablue" value="#69b9ec"/>
    <color id="ochre" value="#ad8534"/>
    <color id="grid" value="#8f8a78"/>
  </palette>
  <terrains>
    <terrain id="sea" name="All-sea hex" fill="seablue" stroke="grid"/>
    <terrain id="hills" name="Hills" fill="ochre" stroke="grid"/>
  </terrains>
  <hexes terrain="hills" ids="w5903 e5901"/>
</sheet>
