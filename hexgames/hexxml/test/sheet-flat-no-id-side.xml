<?xml version="1.0" encoding="UTF-8"?>
<!-- A flat grid that omits id-side. The XSD's default "w" is not a flat hexside, so readers default a flat
     grid to "n". -->
<sheet xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../map_graphics/xml/hexsheet.xsd"
       id="synthetic" title="Synthetic" width="160" height="160" background="frame" urban="symbol" junctions="implicit">
  <grid orientation="flat" offset="odd" cols="2" rows="2" size="30" ox="40" oy="40" id-format="{col:02}{row:02}" terrain="clear"/>
  <palette>
    <color id="frame" value="#ffffff"/>
    <color id="ink" value="#111111"/>
  </palette>
  <terrains>
    <terrain id="clear" name="Clear" fill="frame" stroke="ink"/>
  </terrains>
</sheet>
