<?xml version="1.0" encoding="UTF-8"?>
<sheet id="synthetic" title="Synthetic: an implicit sheet with a junction element" width="100" height="100" background="frame" urban="symbol" junctions="implicit">
  <grid orientation="flat" offset="odd" cols="2" rows="2" size="10" ox="10" oy="10" id-format="{col:02}{row:02}" terrain="clear"/>
  <palette><color id="frame" value="#ffffff"/><color id="grid" value="#000000"/></palette>
  <terrains><terrain id="clear" name="Clear" fill="frame" stroke="grid"/></terrains>
  <lines><line id="road" stroke="grid" width="1"/></lines>
  <link id="a" kind="road" line="road" hexes="0101 0201"/>
  <link id="b" kind="road" line="road" hexes="0102 0201"/>
  <junction at="0201" links="a b"/>
</sheet>
