<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="FpwdMan">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="SiteTable">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="SiteEntry" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="title" type="xs:string"/>
                    <xs:element name="site" type="xs:string"/>
                    <xs:element name="userid" type="xs:string"/>
                    <xs:element name="password" type="xs:string"/>
                    <xs:element name="comments" type="xs:string"/>
                  </xs:sequence>
                </xs:complexType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
