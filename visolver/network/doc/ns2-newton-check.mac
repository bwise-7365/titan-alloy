/* ------------------------------------------------------------------------
   ns2-newton-check.mac -- Maxima double-check of the NS2 structured
   Newton-solver algebra for the flow-planning KKT-LCP (mehrotraIpm's
   NewtonSolverFactory seam). Run:  maxima -q -b ns2-newton-check.mac
   Prints one PASS line per check and "ALL 10 CHECKS PASS" at the end; any
   failure (or any check silently skipped) calls error() and aborts.

   The interior-point Newton matrix for z = [ t | mu | lambda ] (pure NCP,
   flowlcp.hpp packing, t sink-major) is
       K = [ Qblk + diag(Dt) |  E        | d  ]
           [ -E^T            | diag(Dmu) | 0  ]
           [ -d^T            | 0         | Dla ]
   with Qblk block-diagonal BY SINK, each block Q_n * ones (RANK 1),
   Q_n = 2 P_n / D_n^2, E the pair-source incidence, d the pair costs.
   Claims checked, in exact symbolic / rational arithmetic:
     1. Sherman-Morrison inverse of one sink block (symbolic k = 3).
     2. jacobian of the KKT map G reproduces the block structure of M
        stated in flowlcp.hpp (concrete 2-sink / 3-source / 5-pair shape).
     3. The elimination recipe (W by per-sink SM, Schur S on the duals,
        back-substitution for dt) equals the direct solve of K x = r:
        3a fully symbolic on a 1-sink / 2-pair instance,
        3b exact-rational on the full 5-pair instance, with S assembled by
           the two-part scheme (per-pair diagonal accumulation + per-sink
           rank-1 downdates) and the O(k) W-apply shortcut verified,
        3c symbolic k_n = 1 edge case.
     4. S is symmetric (the skew borders cancel) -- justifies LLT.
   Division of labor: this file certifies the MATH; the C++ parity tests
   (NS2) certify the implementation.

   Maxima hygiene (hard-won; keep these):
     - prederror:true so an undecidable predicate ABORTS instead of letting
       an if return a noun form that skips a check silently.
     - scalarmatrixp:false so 1x1 dot products stay matrices and [1,1]
       indexing works in the k_n = 1 edge case.
     - Parameters are substituted via subst(vals, ...) lists, NEVER bound
       globally after the fact: values assigned after an expression is
       stored are not reliably re-evaluated inside it.
     - The zero test is SYNTACTIC after ratsimp (always decidable); a
       counter verifies all 10 checks really executed.
   ------------------------------------------------------------------------ */

prederror: true$
scalarmatrixp: false$

/* ---------- helpers ---------- */

numPass: 0$

zeropmat(Z) := block([R: ratsimp(Z)],
  if matrixp(R)
    then every(lambda([row], every(lambda([e], is(e = 0)), row)), args(R))
    else is(R = 0))$

check(name, Z) := if zeropmat(Z)
  then (numPass: numPass + 1, print(sconcat("PASS: ", name)))
  else error(sconcat("FAIL: ", name))$

diagm(lst) := genmatrix(lambda([i, j], if i = j then lst[i] else 0),
                        length(lst), length(lst))$

colv(lst) := transpose(matrix(lst))$

/* ---------- check 1: Sherman-Morrison for one sink block (symbolic) ----
   (diag(dd) + qq*ones)^-1 = diag(1/dd) - (qq/(1+qq*sigma)) u u^T,
   u = (1/dd_i), sigma = sum 1/dd_i.                                      */

block([dd: [dd1, dd2, dd3], Ablk, u, sigma, Wblk],
  Ablk: diagm(dd) + qq0 * matrix([1,1,1],[1,1,1],[1,1,1]),
  u: colv(makelist(1/dd[i], i, 1, 3)),
  sigma: 1/dd1 + 1/dd2 + 1/dd3,
  Wblk: diagm(makelist(1/dd[i], i, 1, 3))
        - (qq0/(1 + qq0*sigma)) * (u . transpose(u)),
  check("1    Sherman-Morrison sink-block inverse (symbolic k=3)",
        Ablk . Wblk - ident(3)))$

/* ---------- shared concrete shape for checks 2 and 3b -----------------
   2 sinks, 3 sources, 5 pairs, sink-major:
     p1=(s1,n1) p2=(s2,n1) | p3=(s1,n2) p4=(s2,n2) p5=(s3,n2)             */

npair: 5$  nsrc: 3$  ndim: 9$        /* 5 + 3 + 1 */
sinkOf: [1, 1, 2, 2, 2]$
srcOf:  [1, 2, 1, 2, 3]$
slices: [[1, 2], [3, 4, 5]]$         /* I_n, contiguous by sink-major */
dcl: [dc1, dc2, dc3, dc4, dc5]$
Qn: [2*P1/DD1^2, 2*P2/DD2^2]$

/* M as flowlcp.hpp states it, built from the incidence lists (symbolic). */
buildMexp() := block([Mx: zeromatrix(ndim, ndim)],
  for p: 1 thru npair do (
    for r: 1 thru npair do
      if sinkOf[p] = sinkOf[r] then Mx[p, r]: Qn[sinkOf[p]],
    Mx[p, npair + srcOf[p]]: 1,
    Mx[p, ndim]: dcl[p],
    Mx[npair + srcOf[p], p]: -1,
    Mx[ndim, p]: -dcl[p]),
  Mx)$

/* ---------- check 2: jacobian of the KKT map reproduces M -------------- */

block([Gt, Gm, Gl, Glist, zvars, J],
  Gt: [ Qn[1]*(t1 + t2 - DD1)      + (la + eps)*dc1 + mu1,
        Qn[1]*(t1 + t2 - DD1)      + (la + eps)*dc2 + mu2,
        Qn[2]*(t3 + t4 + t5 - DD2) + (la + eps)*dc3 + mu1,
        Qn[2]*(t3 + t4 + t5 - DD2) + (la + eps)*dc4 + mu2,
        Qn[2]*(t3 + t4 + t5 - DD2) + (la + eps)*dc5 + mu3 ],
  Gm: [ CC1 - (t1 + t3),
        CC2 - (t2 + t4),
        CC3 - t5 ],
  Gl: [ LL - (dc1*t1 + dc2*t2 + dc3*t3 + dc4*t4 + dc5*t5) ],
  Glist: append(Gt, Gm, Gl),
  zvars: [t1, t2, t3, t4, t5, mu1, mu2, mu3, la],
  J: jacobian(Glist, zvars),
  check("2    jacobian(G) matches flowlcp.hpp block structure of M",
        J - buildMexp()))$

/* ---------- check 3a: elimination recipe, fully symbolic (1 sink, k=2) --
   W = per-sink SM inverse of the t-block, B = [E d],
   S = diag(dm) + B^T W B,  dual = S^-1 (r_dual + B^T W rt),
   dt = W (rt - B dual).                                                   */

block([Ks, u, sigma, cq, Wsm, Bm, Sm, rt, rdu, dual, dtv, xrec, xdir],
  Ks: matrix([qq0+dt1, qq0,     1,   0,   c1],
             [qq0,     qq0+dt2, 0,   1,   c2],
             [-1,      0,       dm1, 0,   0 ],
             [0,       -1,      0,   dm2, 0 ],
             [-c1,     -c2,     0,   0,   dl]),
  u: colv([1/dt1, 1/dt2]),
  sigma: 1/dt1 + 1/dt2,
  cq: qq0/(1 + qq0*sigma),
  Wsm: diagm([1/dt1, 1/dt2]) - cq * (u . transpose(u)),
  Bm: matrix([1, 0, c1], [0, 1, c2]),
  Sm: diagm([dm1, dm2, dl]) + transpose(Bm) . Wsm . Bm,
  check("4a   S symmetric (skew borders cancel; symbolic)",
        Sm - transpose(Sm)),
  rt: colv([r1, r2]),
  rdu: colv([r3, r4, r5]) + transpose(Bm) . Wsm . rt,
  dual: invert(Sm) . rdu,
  dtv: Wsm . (rt - Bm . dual),
  xrec: matrix([dtv[1,1]], [dtv[2,1]], [dual[1,1]], [dual[2,1]], [dual[3,1]]),
  xdir: invert(Ks) . colv([r1, r2, r3, r4, r5]),
  check("3a   elimination recipe = direct solve (symbolic, 1 sink k=2)",
        xrec - xdir))$

/* ---------- check 3b: full 5-pair instance, exact rationals ------------
   Parameters enter ONLY via this subst list (see hygiene note above).
   S assembled by the TWO-PART scheme exactly as the C++ will do it:
     part 1 (per pair):  B^T diag(a) B  via  S[s,s]+=a_p, S[s,la]+=d_p a_p,
                         S[la,s]+=d_p a_p, S[la,la]+=d_p^2 a_p
     part 2 (per sink):  S -= c_n g_n g_n^T,  g_n = B^T u_n
   plus the O(k) W-apply shortcut, checked against the explicit W matrix.  */

vals: [P1 = 3/2, P2 = 5/3, DD1 = 7/2, DD2 = 9/4,
       dc1 = 3, dc2 = 5/2, dc3 = 4, dc4 = 7/3, dc5 = 11/5]$
Dtl: [2, 3/2, 5/2, 4/3, 7/4]$
Dml: [1/2, 3/4, 5/6]$
DlaV: 2/5$

block([QnN, dclN, av, cn, Wsm, MexpN, Qblk, Kfull, S1, Sm, Sref, Bm, EE,
       xt, yshort, rtl, rml, rlv, rdu, dual, dtv, xrec, xdir, ndual],
  QnN: subst(vals, Qn),
  dclN: subst(vals, dcl),
  MexpN: subst(vals, buildMexp()),
  ndual: nsrc + 1,
  av: makelist(1/Dtl[p], p, 1, npair),
  cn: makelist(QnN[n] / (1 + QnN[n] * apply("+",
        makelist(av[p], p, slices[n][1], last(slices[n])))), n, 1, 2),

  /* explicit W from the per-sink SM formula */
  Wsm: diagm(av),
  for n: 1 thru 2 do block([uf: makelist(0, p, 1, npair)],
    for p in slices[n] do uf[p]: av[p],
    Wsm: Wsm - cn[n] * (colv(uf) . matrix(uf))),

  /* W must invert the t-block of the actual K */
  Qblk: genmatrix(lambda([i, j], MexpN[i, j]), npair, npair),
  check("3b-1 per-sink SM W inverts (Qblk + diag(Dt)) (rational)",
        (Qblk + diagm(Dtl)) . Wsm - ident(npair)),

  /* O(k) W-apply shortcut vs the explicit matrix */
  xt: [1, -2, 3/2, -1/3, 2/5],
  yshort: makelist(av[p] * xt[p], p, 1, npair),
  for n: 1 thru 2 do block([acc: 0],
    for p in slices[n] do acc: acc + av[p] * xt[p],
    for p in slices[n] do yshort[p]: yshort[p] - cn[n] * acc * av[p]),
  check("3b-2 O(k) W-apply shortcut = explicit W . x",
        colv(yshort) - Wsm . colv(xt)),

  /* two-part Schur assembly */
  S1: zeromatrix(ndual, ndual),
  for p: 1 thru npair do block([s: srcOf[p]],
    S1[s, s]:         S1[s, s]         + av[p],
    S1[s, ndual]:     S1[s, ndual]     + dclN[p] * av[p],
    S1[ndual, s]:     S1[ndual, s]     + dclN[p] * av[p],
    S1[ndual, ndual]: S1[ndual, ndual] + dclN[p]^2 * av[p]),
  for n: 1 thru 2 do block([g: makelist(0, s, 1, ndual)],
    for p in slices[n] do (
      g[srcOf[p]]: g[srcOf[p]] + av[p],
      g[ndual]:    g[ndual]    + dclN[p] * av[p]),
    S1: S1 - cn[n] * (colv(g) . matrix(g))),
  Sm: S1 + diagm(append(Dml, [DlaV])),

  /* reference S from the dense definition */
  EE: genmatrix(lambda([p, s], if srcOf[p] = s then 1 else 0), npair, nsrc),
  Bm: addcol(EE, colv(dclN)),
  Sref: diagm(append(Dml, [DlaV])) + transpose(Bm) . Wsm . Bm,
  check("3b-3 two-part S assembly = dense B^T W B + diag", Sm - Sref),
  check("4b   S symmetric (rational, full instance)", Sm - transpose(Sm)),

  /* end-to-end: recipe vs direct solve of the full 9x9 K */
  Kfull: MexpN + diagm(append(Dtl, Dml, [DlaV])),
  rtl: [1, -2, 3/2, -1/3, 2/5],
  rml: [1/2, -3/2, 5/2],
  rlv: -7/3,
  rdu: colv(append(rml, [rlv])) + transpose(Bm) . Wsm . colv(rtl),
  dual: invert(Sm) . rdu,
  dtv: Wsm . (colv(rtl) - Bm . dual),
  xrec: apply(matrix, append(makelist([dtv[p, 1]], p, 1, npair),
                             makelist([dual[s, 1]], s, 1, ndual))),
  xdir: invert(Kfull) . colv(append(rtl, rml, [rlv])),
  check("3b-4 elimination recipe = direct solve (rational, 2 sinks)",
        xrec - xdir))$

/* ---------- check 3c: k_n = 1 edge case (symbolic) --------------------- */

block([K1, Wsm, Bm, Sm, rdu, dual, dtv, xrec, xdir],
  K1: matrix([qq0 + dt1, 1,   c1],
             [-1,        dm1, 0 ],
             [-c1,       0,   dl]),
  /* one pair: u = [1/dt1], sigma = 1/dt1 */
  Wsm: matrix([1/dt1 - (qq0/(1 + qq0/dt1)) * (1/dt1^2)]),
  Bm: matrix([1, c1]),
  Sm: diagm([dm1, dl]) + transpose(Bm) . Wsm . Bm,
  rdu: colv([r2, r3]) + transpose(Bm) . Wsm . matrix([r1]),
  dual: invert(Sm) . rdu,
  dtv: Wsm . (matrix([r1]) - Bm . dual),
  xrec: matrix([dtv[1,1]], [dual[1,1]], [dual[2,1]]),
  xdir: invert(K1) . colv([r1, r2, r3]),
  check("3c   elimination recipe = direct solve (symbolic, k_n = 1)",
        xrec - xdir))$

/* ---------- completeness guard ---------- */

if numPass # 10 then error(sconcat("FAIL: only ", numPass,
                                   " of 10 checks executed"))$
print("ALL 10 CHECKS PASS")$

