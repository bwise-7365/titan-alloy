/* Copyright Ben Paul Wise. All Rights Reserved. */
/* ------------------------------------------------------------------------
   fleet-mcp-check.mac -- Maxima double-check of the fleet-optimizer MCP
   derivation (task G5b; fleet-formulation.md section 9). Run:
       maxima -q -b fleet-mcp-check.mac
   Prints one PASS line per check (9: check 7 has two lines) and
   "ALL 9 CHECKS PASS" at the end; any failure (or any check silently
   skipped) calls error() and aborts.

   The reduced conservative fleet QP has variables y_pk >= 0 (units of
   asset a(p) on kept pair p carried by capable vehicle type k), supply
   multipliers mu per (source, asset) cell, and budget multipliers
   lambda_k per vehicle type (K rows -- the generalization of the base
   model's scalar). KKT is the pure NCP  0 <= M z + q  _|_  z >= 0  with
   z = [ y | mu | lambda ], y CELL-MAJOR (each demand cell's variables
   contiguous), and
     G_y      = Q_cell (R_cell - D_cell) + mu_cell(src) + (la_k + eps) rho
     G_mu     = C_cell - sum y over the cell's pairs
     G_lambda = B_k - sum rho y over the type's variables
   with Q_cell = 2 P / D^2 and rho = roundTrip / kappa.

   Fixture (checks 1-3, 8): 2 assets, 2 sources, 2 sinks, 2 types, with
   asset 2 capable on type 1 ONLY (the incapable (a,k) combos get no
   variable). Demand cells and variables, cell-major:
     cell 1 = (n1,a1): y1=(s1,k1) y2=(s1,k2) y3=(s2,k1) y4=(s2,k2)
     cell 2 = (n1,a2): y5=(s2,k1)
     cell 3 = (n2,a2): y6=(s2,k1)
   Supply cells: mu1=(s1,a1) mu2=(s2,a1) mu3=(s2,a2).  dim = 6+3+2 = 11.
   Claims checked, exact symbolic / rational arithmetic:
     1. jacobian of the KKT map G reproduces the designed block layout of
        M entry-for-entry.
     2. The symmetric part of M is EXACTLY the per-cell rank-one blocks
        (the mu and lambda borders cancel: skew).
     3. The quadratic form of the symmetric part equals
        sum over cells of Q_cell (sum of the cell's v entries)^2 -- a sum
        of squares, hence PSD, hence M monotone.
     4. KKT identity at the UNCONSTRAINED interior optimum of a one-cell
        instance: y* = D - eps rho D^2 / (2P), G_y = 0, slacks positive.
     5. KKT identity at the BUDGET-BOUND optimum: y* = B/rho,
        lambda* = Q (D - y*)/rho - eps, G_y = 0 and G_lambda = 0 exactly.
     6. KKT identity at the CAPACITY-BOUND optimum: y* = C,
        mu* = Q (D - C) - eps rho, G_y = 0 and G_mu = 0 exactly.
     7. Type selection by the tie-break: with two capable types and slack
        budgets, the cheaper-rho type active and the dearer at zero is
        complementary (G of the dear variable = eps (rho2 - rho1) > 0).
     8. Unpack identities on the rational fixture: R per cell = sum of its
        y, per-type usage = sum rho y, reproduced by G_mu and G_lambda.
   Division of labor: this file certifies the MATH; the C++ tests of
   fleetlcp (G5d) certify the implementation and cite these checks.

   Maxima hygiene (from ns2-newton-check.mac; keep these):
     - prederror:true so an undecidable predicate ABORTS instead of
       silently skipping a check.
     - Parameters enter via subst(vals, ...) lists, never bound globally.
     - The zero test is SYNTACTIC after ratsimp; a counter verifies all 8
       checks really executed.
   ------------------------------------------------------------------------ */

prederror: true$
scalarmatrixp: false$

/* ---------- helpers ---------- */

numPass: 0$

zeropmat(Z) := block([R: ratsimp(Z)],
  if matrixp(R)
    then every(lambda([row], every(lambda([e], is(e = 0)), row)), args(R))
    else is(R = 0))$

check(name, Z) := if zeropmat(Z)
  then (numPass: numPass + 1, print(sconcat("PASS: ", name)))
  else error(sconcat("FAIL: ", name))$

/* ---------- shared fixture shape (see header) -------------------------- */

nvar: 6$  nmu: 3$  nla: 2$  ndim: 11$
cellOf: [1, 1, 1, 1, 2, 3]$          /* demand cell of each y variable   */
muOf:   [1, 1, 2, 2, 3, 3]$          /* supply cell of each y variable   */
laOf:   [1, 2, 1, 2, 1, 1]$          /* vehicle type of each y variable  */
rhol:   [rr1, rr2, rr3, rr4, rr5, rr6]$
Qc:     [2*Pa/DA^2, 2*Pb/DB^2, 2*Pc/DC^2]$
cells:  [[1, 2, 3, 4], [5], [6]]$    /* cell-major, contiguous           */

/* M as fleetlcp.hpp will state it, built from the incidence lists. */
buildMexp() := block([Mx: zeromatrix(ndim, ndim)],
  for p: 1 thru nvar do (
    for r: 1 thru nvar do
      if cellOf[p] = cellOf[r] then Mx[p, r]: Qc[cellOf[p]],
    Mx[p, nvar + muOf[p]]: 1,
    Mx[p, nvar + nmu + laOf[p]]: rhol[p],
    Mx[nvar + muOf[p], p]: -1,
    Mx[nvar + nmu + laOf[p], p]: -rhol[p]),
  Mx)$

/* ---------- check 1: jacobian of the KKT map reproduces M -------------- */

Gy: [ Qc[1]*(y1 + y2 + y3 + y4 - DA) + mu1 + (la1 + eps)*rr1,
      Qc[1]*(y1 + y2 + y3 + y4 - DA) + mu1 + (la2 + eps)*rr2,
      Qc[1]*(y1 + y2 + y3 + y4 - DA) + mu2 + (la1 + eps)*rr3,
      Qc[1]*(y1 + y2 + y3 + y4 - DA) + mu2 + (la2 + eps)*rr4,
      Qc[2]*(y5 - DB)                + mu3 + (la1 + eps)*rr5,
      Qc[3]*(y6 - DC)                + mu3 + (la1 + eps)*rr6 ]$
Gm: [ CA - (y1 + y2),
      CB - (y3 + y4),
      CC - (y5 + y6) ]$
Gl: [ B1 - (rr1*y1 + rr3*y3 + rr5*y5 + rr6*y6),
      B2 - (rr2*y2 + rr4*y4) ]$
Glist: append(Gy, Gm, Gl)$
zvars: [y1, y2, y3, y4, y5, y6, mu1, mu2, mu3, la1, la2]$

check("1    jacobian(G) matches the designed fleet M block layout",
      jacobian(Glist, zvars) - buildMexp())$

/* ---------- check 2: symmetric part = per-cell rank-one blocks --------- */

block([Mx, Msym, Mblocks],
  Mx: buildMexp(),
  Msym: (Mx + transpose(Mx)) / 2,
  Mblocks: zeromatrix(ndim, ndim),
  for p: 1 thru nvar do
    for r: 1 thru nvar do
      if cellOf[p] = cellOf[r] then Mblocks[p, r]: Qc[cellOf[p]],
  check("2    symmetric part of M = per-cell Q blocks (borders cancel)",
        Msym - Mblocks))$

/* ---------- check 3: quadratic form is a sum of squares (PSD) ---------- */

block([vv, Msym, form, sos],
  vv: [v1, v2, v3, v4, v5, v6, v7, v8, v9, v10, v11],
  Msym: (buildMexp() + transpose(buildMexp())) / 2,
  form: expand(matrix(vv) . Msym . transpose(matrix(vv))),
  sos: Qc[1]*(v1 + v2 + v3 + v4)^2 + Qc[2]*v5^2 + Qc[3]*v6^2,
  check("3    v' sym(M) v = sum over cells of Q (cell sum)^2  (PSD)",
        form - sos))$

/* ---------- checks 4-6: KKT identities on a one-cell instance ----------
   One pair, one capable type: G_y = Q (y - D) + mu + (la + eps) rho,
   G_mu = C - y, G_la = B - rho y, with Q = 2 P / D^2. Exact rationals;
   each regime's active G rows must vanish exactly and its slacks must be
   strictly positive (positivity asserted via prederror-guarded if).     */

posp(name, e) := if is(ratsimp(e) > 0) then true
  else error(sconcat("FAIL (not positive): ", name))$

/* check 4: unconstrained interior optimum */
block([vals, Q, ystar, gy, gmu, gla],
  vals: [P = 3/2, D = 7/2, rho = 5/2, C = 6, B = 40, eps = 1/100],
  Q: subst(vals, 2*P/D^2),
  ystar: subst(vals, D - eps*rho*D^2/(2*P)),
  gy:  ratsimp(subst(vals, Q*(ystar - D) + 0 + (0 + eps)*rho)),
  gmu: ratsimp(subst(vals, C - ystar)),
  gla: ratsimp(subst(vals, B - rho*ystar)),
  posp("check-4 capacity slack", gmu),
  posp("check-4 budget slack", gla),
  check("4    KKT at the unconstrained optimum: G_y = 0, slacks > 0", gy))$

/* check 5: budget-bound optimum, shadow price lambda* */
block([vals, Q, ystar, lastar, gy, gla],
  vals: [P = 3/2, D = 7/2, rho = 5/2, B = 4, eps = 1/100],
  Q: subst(vals, 2*P/D^2),
  ystar: subst(vals, B/rho),                    /* = 8/5 < D: budget binds */
  lastar: ratsimp(subst(vals, Q*(D - B/rho)/rho - eps)),
  posp("check-5 lambda* positive", lastar),
  gy:  ratsimp(subst(vals, Q*(ystar - D) + (lastar + eps)*rho)),
  gla: ratsimp(subst(vals, B - rho*ystar)),
  check("5    KKT at the budget-bound optimum: G_y = 0 and G_la = 0",
        matrix([gy], [gla])))$

/* check 6: capacity-bound optimum, multiplier mu* */
block([vals, Q, ystar, mustar, gy, gmu],
  vals: [P = 3/2, D = 7/2, rho = 5/2, C = 2, eps = 1/100],
  Q: subst(vals, 2*P/D^2),
  ystar: subst(vals, C),                        /* = 2 < D: capacity binds */
  mustar: ratsimp(subst(vals, Q*(D - C) - eps*rho)),
  posp("check-6 mu* positive", mustar),
  gy:  ratsimp(subst(vals, Q*(ystar - D) + mustar + (0 + eps)*rho)),
  gmu: ratsimp(subst(vals, C - ystar)),
  check("6    KKT at the capacity-bound optimum: G_y = 0 and G_mu = 0",
        matrix([gy], [gmu])))$

/* ---------- check 7: tie-break selects the cheaper type ----------------
   One pair, TWO capable types rho1 < rho2, slack capacity and budgets.
   Candidate: all flow on type 1 at the check-4 interior value for rho1,
   type 2 at zero. Complementarity requires G_y1 = 0 (active) and
   G_y2 >= 0 (inactive); here G_y2 = eps (rho2 - rho1) > 0 exactly.     */

block([vals, Q, ystar, gy1, gy2],
  vals: [P = 3/2, D = 7/2, rho1 = 5/2, rho2 = 11/4, eps = 1/100],
  Q: subst(vals, 2*P/D^2),
  ystar: subst(vals, D - eps*rho1*D^2/(2*P)),
  gy1: ratsimp(subst(vals, Q*(ystar - D) + (0 + eps)*rho1)),
  gy2: ratsimp(subst(vals, Q*(ystar - D) + (0 + eps)*rho2)),
  check("7a   cheap-type stationarity: G_y1 = 0", gy1),
  posp("check-7 dear-type slack = eps (rho2 - rho1)", gy2),
  check("7b   dear-type slack equals eps (rho2 - rho1) exactly",
        gy2 - subst(vals, eps*(rho2 - rho1))))$

/* ---------- check 8: unpack identities on the rational fixture ---------
   For a concrete y >= 0: delivered per cell = sum of its y, per-type
   usage = sum rho y, and the G_mu / G_lambda rows reproduce C - supply
   and B - usage. Definitional, but it pins the incidence lists the C++
   unpacker and certificate pricing will use.                            */

block([vals, yv, Rcells, use1, use2, gmv, glv],
  vals: [rr1 = 3, rr2 = 7/2, rr3 = 4, rr4 = 9/2, rr5 = 5, rr6 = 2,
         Pa = 3/2, Pb = 5/3, Pc = 2, DA = 7/2, DB = 9/4, DC = 3,
         CA = 6, CB = 5, CC = 4, B1 = 40, B2 = 30,
         mu1 = 0, mu2 = 0, mu3 = 0, la1 = 0, la2 = 0, eps = 0,
         y1 = 1, y2 = 1/2, y3 = 3/4, y4 = 1/4, y5 = 2, y6 = 1/3],
  Rcells: subst(vals, [y1 + y2 + y3 + y4, y5, y6]),
  use1: subst(vals, rr1*y1 + rr3*y3 + rr5*y5 + rr6*y6),
  use2: subst(vals, rr2*y2 + rr4*y4),
  gmv: subst(vals, Gm),
  glv: subst(vals, Gl),
  check("8    unpack identities: G_mu = C - supply, G_la = B - usage",
        matrix([gmv[1] - (subst(vals, CA) - subst(vals, y1 + y2))],
               [gmv[2] - (subst(vals, CB) - subst(vals, y3 + y4))],
               [gmv[3] - (subst(vals, CC) - subst(vals, y5 + y6))],
               [glv[1] - (subst(vals, B1) - use1)],
               [glv[2] - (subst(vals, B2) - use2)])))$

/* ---------- completeness guard ---------- */

/* checks: 1, 2, 3, 4, 5, 6, 7a, 7b, 8 -> 9 PASS lines expected */
if numPass # 9 then error(sconcat("FAIL: only ", numPass,
                                  " of 9 checks executed"))$
print("ALL 9 CHECKS PASS")$

