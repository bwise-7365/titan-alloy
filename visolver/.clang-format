# Copyright Ben Paul Wise. All Rights Reserved.
# Deterministic slice of the personal C++ style (see doc/ style guide). Captures
# only what a formatter can express safely; the banner comments, Yoda conditions,
# `using` imports, and explicit `return;` are applied by hand, not here.
---
Language:        Cpp
BasedOnStyle:    LLVM
IndentWidth:     2
TabWidth:        2
UseTab:          Never
ColumnLimit:     100
NamespaceIndentation: All
PointerAlignment: Left
SortIncludes:    Never
SpacesBeforeTrailingComments: 2
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: false
# Return type on its own line for out-of-line DEFINITIONS only (declarations stay
# one line). On clang-format >= 19 this key is renamed 'BreakAfterReturnType: TopLevel'.
AlwaysBreakAfterReturnType: TopLevelDefinitions
# K&R braces for control flow and class/struct/namespace; Allman for function
# bodies; 'else' on its own line.
BreakBeforeBraces: Custom
BraceWrapping:
  AfterClass:      false
  AfterStruct:     false
  AfterEnum:       false
  AfterUnion:      false
  AfterNamespace:  false
  AfterControlStatement: Never
  AfterFunction:   true
  BeforeElse:      true
  BeforeCatch:     true
  SplitEmptyFunction: false
...
