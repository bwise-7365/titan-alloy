// Copyright Ben Paul Wise. All Rights Reserved.
// Windows version-resource metadata: what Explorer's File Properties > Details tab
// reads for the .exe (LegalCopyright, ProductName, etc). Generated per app by
// irrgo_add_version_resource() (see gui_common/CMakeLists.txt), which fills in
// @appName@ via configure_file.
//
// FILEOS 0x00040004L = VOS_NT_WINDOWS32; FILETYPE 0x00000001L = VFT_APP (see
// winver.h) -- spelled out numerically so this .rc has no header dependency.
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x00040004L
FILETYPE        0x00000001L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",     "Ben Paul Wise"
            VALUE "FileDescription", "@appName@"
            VALUE "FileVersion",     "1.0.0.0"
            VALUE "LegalCopyright",  "Copyright Ben Paul Wise. All Rights Reserved."
            VALUE "ProductName",     "@appName@"
            VALUE "ProductVersion",  "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
// Copyright Ben Paul Wise. All Rights Reserved.
