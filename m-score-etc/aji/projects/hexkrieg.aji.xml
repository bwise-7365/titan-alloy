<?xml version="1.0" encoding="UTF-8"?>
<!-- HexKrieg, Java 17. HexKrieg declares only coarse layers, by source root
     (CLAUDE.md): the headless engine in src/ must compile alone; the Swing front end
     (src-gui/) and the continuous-motion simulation (src-hksim/) sit on top of it.
     Everything in src/ and src-gui/ is in one package, so dependencies within it are
     found through simple type names.

     The sibling HexRules sources are not part of this project; references to them are
     ignored. Tests are left out; delete the <exclude> line to include them as a third
     layer below the others.

     Because src/ is one declared layer of about sixty files, run this file also with
     -layers derived to compare with layers derived from the dependencies. -->
<aji-project name="hexkrieg" root="../../../../HexKrieg" language="java">
  <exclude glob="test/**"/>
  <layer number="1" name="engine (src)">
    <path glob="src/**"/>
  </layer>
  <layer number="2" name="front ends (gui, hksim)">
    <path glob="src-gui/**"/>
    <path glob="src-hksim/**"/>
  </layer>
  <layer number="3" name="tests">
    <path glob="test/**"/>
  </layer>
</aji-project>
