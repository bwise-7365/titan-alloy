@startuml LegSequence
title One Itinerary Leg — Event Sequence with Staggered Transfers
' T1 = leg.src.transferSrtTime    T2 = leg.src.transferEndTime
' T3 = leg.dst.transferSrtTime    T4 = leg.dst.transferEndTime
' N = serials in src.transfer      M = serials in dst.transfer
' ΔTs = T2−T1                      ΔTd = T4−T3

participant "Scheduler" as S
participant "TEntity"   as TE
participant "SEntity[i]" as SE
participant "LogAdj\n(recordEvent)" as LA

== Scanning → Loading (doScanning) ==

S  -> TE : process() [Scanning]
TE -> TE : buildAndValidateItinerary()
TE -> TE : initLegState(0)
TE -> S  : addEvent(TE, t = T1)

== Loading: precondition check (t = T1, pickupCounter = −1) ==

S  -> TE : process() [Loading, t = T1]
TE -> TE : validateItinerary() [assert validP]
TE -> TE : assertSerialsAtNode(srcNode, sns)
TE -> LA : TransportRecord(T1, start, load, srcNode, sns)
TE -> LA : SerialRecord(T1, start, load, sn[0..N−1])
note right TE : pickupCounter = 0
TE -> S  : addEvent(TE, t = T1 + 1·ΔTs/(N+2))

== Loading: staggered pickups (N events) ==

loop i = 0 to N−1, at T1 + (i+1)·ΔTs/(N+2)
    S  -> TE : process() [Loading, pickupCounter = i]
    TE -> TE : onBoard += sn[i]
    TE -> SE : notifyPickUp(sn[i]) → receivePickUp(TE)
    SE -> SE : verifyPrePickup()
    note right SE : assert TravelLog.validP()\nassert currLoc == srcNode
    SE -> SE : setLoc(TE.name)
    SE -> SE : logPickUp(srcNode, TE.name)
    note right SE : pendingPickupStop saved\ncurrLoc = transport name\nstate = Loading
    SE -> SE : recordPickup(TE.name)  [DCVRP state]
    TE -> S  : addEvent(TE, t = next staggered time or T2)
end

== Loading: postcondition + departure (t = T2, pickupCounter = N) ==

S  -> TE : process() [Loading, t = T2]
TE -> TE : assertSerialsOnTransport(TE.name, sns)
TE -> LA : SerialRecord(T2, finish, load, sn[0..N−1])
TE -> LA : TransportRecord(T2, finish, load, srcNode, sns)
TE -> SE : notifyDeparture(TE)  [all N on-board serials]
note right SE : state: Loading → Moving
TE -> TE : state = Moving
TE -> S  : addEvent(TE, t = T3)

== Moving: transit — no DES events fire between T2 and T3 ==

== Arrival at dst (t = T3) ==

S  -> TE : process() [Moving, t = T3]
TE -> TE : arriveAtDst(): setLoc(dstNode), myTrans.currNode = dst.node
TE -> SE : notifyArrival(TE)  [all on-board serials]
note right SE : state: Moving → Unloading
TE -> TE : state = Unloading, dropoffCounter = −1
TE -> S  : addEvent(TE, t = T3)  [same timestamp → triggers doUnloading]

== Unloading: precondition check (t = T3, dropoffCounter = −1) ==

S  -> TE : process() [Unloading, t = T3]
TE -> TE : assertSerialsOnTransport(TE.name, sns)
TE -> LA : TransportRecord(T3, start, unload, dstNode, sns)
TE -> LA : SerialRecord(T3, start, unload, sn[0..M−1])
note right TE : dropoffCounter = 0
TE -> S  : addEvent(TE, t = T3 + 1·ΔTd/(M+2))

== Unloading: staggered dropoffs (M events) ==

loop i = 0 to M−1, at T3 + (i+1)·ΔTd/(M+2)
    S  -> TE : process() [Unloading, dropoffCounter = i]
    TE -> TE : onBoard -= sn[i]
    TE -> SE : notifyDropOff(sn[i]) → receiveDO(TE)
    SE -> SE : verifyPreDropoff()
    note right SE : assert currLoc == TE.name
    SE -> SE : setLoc(dstNode)
    SE -> SE : recordDropoff(dstNode, false)  [DCVRP state]
    SE -> SE : logDropOff(dstNode, TE.name)
    note right SE : Leg appended to TravelLog\ncurrLoc = dstNode
    SE -> SE : verifyPostDropoff()
    note right SE : assert TravelLog.validP()
    alt currLoc == deliveryNodeName
        SE -> SE : state = Stop
    else
        SE -> SE : state = Scanning → doScanning()
    end
    TE -> S  : addEvent(TE, t = next staggered time or T4)
end

== Unloading: postcondition (t = T4, dropoffCounter = M) ==

S  -> TE : process() [Unloading, t = T4]
TE -> TE : assertSerialsAtNode(dstNode, sns)
TE -> LA : SerialRecord(T4, finish, unload, sn[0..M−1])
TE -> LA : TransportRecord(T4, finish, unload, dstNode, sns)

alt more legs remain
    TE -> TE : initLegState(legIdx+1)\nstate = Loading
    TE -> S  : addEvent(TE, t = next leg T1)
else itinerary complete
    TE -> TE : state = Scanning
    TE -> S  : addEvent(TE, t = T4 + PLAN_INTERVAL)
end

@enduml
